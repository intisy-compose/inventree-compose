(inventree) {
	encode gzip
	request_body {
		max_size 100MB
	}
	handle_path /static/* {
		root * /srv/inventree/static
		file_server
	}
	# Uploaded files are served only to signed-in users; InvenTree answers the auth check.
	handle_path /media/* {
		forward_auth server:8000 {
			uri /auth/
		}
		root * /srv/media
		file_server
	}
	handle {
		reverse_proxy server:8000
	}
}

{$TAILNET_HOST}:443 {
	import tailnet
	import inventree
}

http://:8441 {
	import inventree
}
