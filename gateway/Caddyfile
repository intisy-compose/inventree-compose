# tailscale shares this container's network namespace. Certificates for the ts.net name come from
# tailscaled over its socket, never from a public CA, so every device on the tailnet gets real HTTPS.
{
	admin off
	auto_https disable_redirects
}

(inventree) {
	encode gzip
	request_body {
		max_size 100MB
	}
	handle_path /static/* {
		root * /srv/inventree/static
		file_server
	}
	# Uploaded files are served only to signed-in users; InvenTree answers the auth check.
	handle_path /media/* {
		forward_auth server:8000 {
			uri /auth/
		}
		root * /srv/inventree/media
		file_server
	}
	handle {
		reverse_proxy server:8000
	}
}

{$INVENTREE_HOST}:443 {
	tls {
		get_certificate tailscale
	}
	import inventree
}

# This PC only: the port is published on 127.0.0.1, and tailnet traffic reaches nothing but :443.
http://:8441 {
	import inventree
}
