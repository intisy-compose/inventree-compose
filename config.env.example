# Copy to config.env (gitignored), or run `.\docker-compose.ps1 init-config`, which copies this file
# and fills every empty secret below with a freshly generated value.

# Tailscale. InvenTree joins your tailnet as TS_HOSTNAME and is served at
# https://<TS_HOSTNAME>.<tailnet>.ts.net. TS_AUTHKEY is only needed for the first join; create one at
# https://login.tailscale.com/admin/settings/keys. HTTPS certificates must be enabled for the tailnet.
TS_AUTHKEY=
TS_HOSTNAME=inventree

# Written by `docker-compose.ps1 up` once the node has joined; leave it empty.
INVENTREE_HOST=

# The first admin account, created on the first start. The catalog tool signs in with it too.
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_EMAIL=admin@localhost

# Generated by init-config.
INVENTREE_ADMIN_PASSWORD=
POSTGRES_PASSWORD=

TIMEZONE=Europe/Berlin

# How many hourly database dumps data/backups keeps.
BACKUP_KEEP=48

# `catalog previews` renders the 3D-printed parts with Blender from their exported STL files. BLENDER is
# the blender executable; DESIGN_DIRS lists the folders that hold the design folders, separated by ;.
BLENDER=
DESIGN_DIRS=
